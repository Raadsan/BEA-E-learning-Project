generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model IELTSTOEFL {
  student_id              String          @id @db.VarChar(50)
  student_reg_number      String?         @unique(map: "student_id_number") @db.VarChar(20)
  first_name              String          @db.VarChar(255)
  last_name               String          @db.VarChar(255)
  email                   String          @db.VarChar(255)
  phone                   String?         @db.VarChar(50)
  password                String?         @db.VarChar(255)
  age                     Int?
  sex                     IELTSTOEFL_sex? @default(Male)
  date_of_birth           DateTime?       @db.Date
  place_of_birth          String?         @db.VarChar(255)
  residency_country       String?         @db.VarChar(255)
  residency_city          String?         @db.VarChar(255)
  exam_type               String          @db.VarChar(255)
  verification_method     String          @db.VarChar(255)
  certificate_institution String?         @db.VarChar(255)
  certificate_date        DateTime?       @db.Date
  certificate_document    String?         @db.VarChar(255)
  exam_booking_date       DateTime?       @db.Date
  exam_booking_time       String?         @db.VarChar(50)
  registration_date       DateTime?       @default(now()) @db.DateTime(0)
  status                  String?         @default("Pending") @db.VarChar(50)
  paid_until              DateTime?       @db.DateTime(0)
  funding_status          String?         @default("Unpaid") @db.VarChar(50)
  funding_amount          Decimal?        @db.Decimal(10, 2)
  funding_month           String?         @db.VarChar(50)
  updated_at              DateTime?       @default(now()) @db.DateTime(0)
  class_id                Int?
  chosen_program          String?         @db.VarChar(255)
  payment_method          String?         @db.VarChar(50)
  transaction_id          String?         @db.VarChar(255)
  payment_amount          Decimal?        @db.Decimal(10, 2)
  payer_phone             String?         @db.VarChar(50)
  reminder_sent           Boolean?        @default(false)
  is_extended             Boolean?        @default(false)
  expiry_date             DateTime?       @db.DateTime(0)
  admin_expiry_notified   Boolean?        @default(false)
  created_by              Int?
  updated_by              Int?
  created_by_name         String?         @db.VarChar(200)
  updated_by_name         String?         @db.VarChar(200)
}

model ProficiencyTestStudents {
  id                    Int                                       @id @default(autoincrement())
  student_id            String                                    @unique(map: "student_id") @db.VarChar(255)
  first_name            String                                    @db.VarChar(255)
  last_name             String                                    @db.VarChar(255)
  email                 String                                    @unique(map: "email") @db.VarChar(255)
  phone                 String?                                   @db.VarChar(255)
  password              String                                    @db.VarChar(255)
  educational_level     ProficiencyTestStudents_educational_level
  reason_essay          String                                    @db.Text
  status                ProficiencyTestStudents_status?           @default(Pending)
  payment_status        ProficiencyTestStudents_payment_status?   @default(unpaid)
  expiry_date           DateTime?                                 @default(now()) @db.DateTime(0)
  is_extended           Boolean?                                  @default(false)
  registration_date     DateTime?                                 @default(now()) @db.DateTime(0)
  reminder_sent         Boolean?                                  @default(false)
  admin_expiry_notified Boolean?                                  @default(false)
  age                   Int?
  sex                   String?                                   @db.VarChar(255)
  date_of_birth         DateTime?                                 @db.Date
  place_of_birth        String?                                   @db.VarChar(255)
  residency_country     String?                                   @db.VarChar(255)
  residency_city        String?                                   @db.VarChar(255)
  created_by            Int?
  updated_by            Int?
  created_by_name       String?                                   @db.VarChar(200)
  updated_by_name       String?                                   @db.VarChar(200)
}

model migrations {
  id         Int       @id @default(autoincrement())
  filename   String    @unique(map: "filename") @db.VarChar(255)
  applied_at DateTime? @default(now()) @db.Timestamp(0)

  @@map("_migrations")
}

model academic_calendar {
  id                   Int         @id @default(autoincrement())
  program_id           Int
  subprogram_id        Int
  week_number          Int
  day_of_week          String      @db.VarChar(20)
  activity_type        String      @db.VarChar(100)
  activity_title       String      @db.VarChar(255)
  activity_description String?     @db.Text
  created_at           DateTime?   @default(now()) @db.Timestamp(0)
  updated_at           DateTime?   @default(now()) @db.Timestamp(0)
  programs             programs    @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "academic_calendar_ibfk_1")
  subprograms          subprograms @relation(fields: [subprogram_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "academic_calendar_ibfk_2")

  @@index([program_id], map: "idx_program")
  @@index([subprogram_id, week_number], map: "idx_subprogram_week")
}

model admins {
  id                     Int       @id @default(autoincrement())
  first_name             String?   @db.VarChar(100)
  last_name              String?   @db.VarChar(100)
  email                  String    @unique(map: "email") @db.VarChar(255)
  phone                  String?   @db.VarChar(50)
  password               String    @db.VarChar(255)
  role                   String?   @default("admin") @db.VarChar(50)
  status                 String?   @default("active") @db.VarChar(50)
  created_at             DateTime? @default(now()) @db.Timestamp(0)
  updated_at             DateTime? @default(now()) @db.Timestamp(0)
  reset_password_token   String?   @db.VarChar(255)
  reset_password_expires DateTime? @db.DateTime(0)
  username               String?   @unique(map: "username") @db.VarChar(100)
  full_name              String?   @db.VarChar(200)
  bio                    String?   @db.Text
  profile_image          String?   @db.VarChar(500)
  profile_picture        String?   @db.VarChar(255)
  permissions            String?   @db.Text
  created_by             Int?
  updated_by             Int?
  created_by_name        String?   @db.VarChar(200)
  updated_by_name        String?   @db.VarChar(200)

  @@index([email], map: "idx_email")
}

model announcements {
  id              Int                   @id @default(autoincrement())
  title           String                @db.VarChar(255)
  content         String                @db.Text
  target_audience String?               @default("All Students") @db.VarChar(100)
  publish_date    DateTime              @db.Date
  status          announcements_status? @default(Published)
  created_at      DateTime?             @default(now()) @db.Timestamp(0)
  updated_at      DateTime?             @default(now()) @db.Timestamp(0)
  target_type     String?               @default("manual") @db.VarChar(50)
  target_id       Int?
}

model assignment_submissions {
  id              Int                            @id @default(autoincrement())
  assignment_id   Int
  student_id      String?                        @db.VarChar(50)
  submission_date DateTime?                      @db.DateTime(0)
  score           Int?
  status          assignment_submissions_status? @default(pending)
  feedback        String?                        @db.Text
  file_url        String?                        @db.VarChar(500)
  created_at      DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at      DateTime?                      @default(now()) @db.Timestamp(0)
  content         String?                        @db.LongText
  is_auto_submit  Boolean?                       @default(false)
  assignments     assignments                    @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_submissions_ibfk_1")
  students        students?                      @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "assignment_submissions_ibfk_2")

  @@unique([assignment_id, student_id], map: "unique_submission")
  @@index([assignment_id], map: "idx_assignment_id")
  @@index([status], map: "idx_status")
  @@index([student_id], map: "idx_student_id")
}

model assignments {
  id                     Int                      @id @default(autoincrement())
  title                  String                   @db.VarChar(255)
  description            String?                  @db.Text
  class_id               Int
  program_id             Int?
  created_by             Int?
  type                   assignments_type?        @default(assignment)
  due_date               DateTime?                @db.DateTime(0)
  start_date             DateTime?                @db.DateTime(0)
  total_points           Int?                     @default(100)
  status                 assignments_status?      @default(active)
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                @default(now()) @db.Timestamp(0)
  word_count             Int?
  duration               Int?
  submission_format      String?                  @db.VarChar(100)
  requirements           String?                  @db.Text
  assignment_submissions assignment_submissions[]
  classes                classes                  @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignments_ibfk_1")

  @@index([class_id], map: "idx_class_id")
  @@index([due_date], map: "idx_due_date")
  @@index([program_id], map: "idx_program_id")
  @@index([status], map: "idx_status")
}

model attendance {
  id         Int       @id @default(autoincrement())
  class_id   Int
  student_id String?   @db.VarChar(50)
  date       DateTime  @db.Date
  hour1      Int?      @default(0) @db.TinyInt
  hour2      Int?      @default(0) @db.TinyInt
  excuse     Int?      @default(0) @db.TinyInt
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  classes    classes   @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_ibfk_1")
  students   students? @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_ibfk_2")

  @@unique([class_id, student_id, date], map: "unique_attendance")
  @@index([student_id], map: "attendance_ibfk_2")
}

model certificates {
  id                  Int                      @id @default(autoincrement())
  target_id           Int
  target_type         certificates_target_type
  template_url        String                   @db.VarChar(255)
  name_x              Int?                     @default(300)
  name_y              Int?                     @default(400)
  font_size           Int?                     @default(30)
  font_color          String?                  @default("#000000") @db.VarChar(20)
  fields_config       Json?
  created_at          DateTime?                @default(now()) @db.Timestamp(0)
  updated_at          DateTime?                @default(now()) @db.Timestamp(0)
  uploader_id         Int?
  created_by          Int?
  updated_by          Int?
  created_by_name     String?                  @db.VarChar(200)
  updated_by_name     String?                  @db.VarChar(200)
  issued_certificates issued_certificates[]

  @@unique([target_id, target_type], map: "unique_target")
}

model class_schedules {
  id            Int       @id @default(autoincrement())
  class_id      Int
  session_title String?   @db.VarChar(255)
  zoom_link     String?   @db.Text
  schedule_date DateTime? @db.Date
  start_time    DateTime? @db.Time(0)
  end_time      DateTime? @db.Time(0)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  classes       classes   @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "class_schedules_ibfk_1")

  @@index([class_id], map: "idx_class_id")
  @@index([schedule_date], map: "idx_date")
}

model classes {
  id                                                                          Int                       @id @default(autoincrement())
  class_name                                                                  String                    @unique(map: "class_name") @db.VarChar(255)
  description                                                                 String?                   @db.Text
  course_id                                                                   Int?
  teacher_id                                                                  Int?
  schedule                                                                    String?                   @db.VarChar(255)
  created_at                                                                  DateTime                  @default(now()) @db.Timestamp(0)
  updated_at                                                                  DateTime                  @default(now()) @db.Timestamp(0)
  subprogram_id                                                               Int?
  shift_id                                                                    Int?
  created_by                                                                  Int?
  updated_by                                                                  Int?
  created_by_name                                                             String?                   @db.VarChar(200)
  updated_by_name                                                             String?                   @db.VarChar(200)
  assignments                                                                 assignments[]
  attendance                                                                  attendance[]
  class_schedules                                                             class_schedules[]
  courses                                                                     courses?                  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "classes_ibfk_1")
  teachers                                                                    teachers?                 @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "classes_ibfk_2")
  shifts                                                                      shifts?                   @relation(fields: [shift_id], references: [id], onUpdate: NoAction, map: "fk_class_shift")
  subprograms                                                                 subprograms?              @relation(fields: [subprogram_id], references: [id], onUpdate: NoAction, map: "fk_classes_subprogram")
  session_change_requests_session_change_requests_current_class_idToclasses   session_change_requests[] @relation("session_change_requests_current_class_idToclasses")
  session_change_requests_session_change_requests_requested_class_idToclasses session_change_requests[] @relation("session_change_requests_requested_class_idToclasses")
  student_reviews                                                             student_reviews[]
  students                                                                    students[]
  teacher_reviews                                                             teacher_reviews[]

  @@index([shift_id], map: "fk_class_shift")
  @@index([subprogram_id], map: "fk_classes_subprogram")
  @@index([course_id], map: "idx_course_id")
  @@index([teacher_id], map: "idx_teacher_id")
}

model contacts {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  email      String   @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  message    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_created_at")
  @@index([email], map: "idx_email")
}

model contact_page_settings {
  id                   Int      @id @default(1)
  hero_title           String   @db.VarChar(255)
  hero_subtitle        String   @db.VarChar(255)
  hero_description     String   @db.Text
  address              String   @db.VarChar(500)
  phone                String   @db.VarChar(100)
  email                String   @db.VarChar(255)
  social_links         Json
  schedule_title       String   @db.VarChar(255)
  schedule_description String   @db.Text
  schedule             Json
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model course_timeline {
  id             Int       @id @default(autoincrement())
  term_serial    String    @unique(map: "term_serial") @db.VarChar(50)
  start_date     DateTime  @db.Date
  end_date       DateTime  @db.Date
  holidays       String?   @db.Text
  class_ids      Json?
  subprogram_ids Json?
  display_order  Int
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)

  @@index([display_order], map: "idx_display_order")
  @@index([is_active], map: "idx_is_active")
}

model course_work {
  id                      Int                       @id @default(autoincrement())
  title                   String                    @db.VarChar(255)
  description             String?                   @db.Text
  class_id                Int
  program_id              Int?
  due_date                DateTime?                 @db.DateTime(0)
  start_date              DateTime?                 @db.DateTime(0)
  total_points            Int?                      @default(100)
  status                  course_work_status?       @default(active)
  created_by              Int
  submission_format       String?                   @db.VarChar(100)
  questions               String?                   @db.LongText
  created_at              DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(0)
  word_count              Int?
  duration                Int?
  requirements            String?                   @db.Text
  subprogram_id           Int?
  unit                    String?                   @db.VarChar(255)
  course_work_submissions course_work_submissions[]
}

model course_work_submissions {
  id                Int                             @id @default(autoincrement())
  assignment_id     Int
  student_id        String?                         @db.VarChar(50)
  content           String?                         @db.LongText
  file_url          String?                         @db.VarChar(255)
  score             Decimal?                        @db.Decimal(5, 2)
  feedback          String?                         @db.Text
  feedback_file_url String?                         @db.VarChar(255)
  status            course_work_submissions_status? @default(pending)
  submission_date   DateTime?                       @db.DateTime(0)
  created_at        DateTime?                       @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                       @default(now()) @db.Timestamp(0)
  course_work       course_work                     @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_work_submissions_ibfk_1")

  @@unique([assignment_id, student_id], map: "unique_submission")
}

model courses {
  id            Int         @id @default(autoincrement())
  course_title  String      @db.VarChar(255)
  subprogram_id Int
  description   String?     @db.Text
  duration      String?     @db.VarChar(100)
  price         Decimal?    @db.Decimal(10, 2)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @db.Timestamp(0)
  classes       classes[]
  subprograms   subprograms @relation(fields: [subprogram_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "courses_ibfk_1")

  @@index([subprogram_id], map: "idx_subprogram_id")
}

model exam_submissions {
  id                Int                      @id @default(autoincrement())
  assignment_id     Int
  student_id        String?                  @db.VarChar(50)
  content           String?                  @db.LongText
  file_url          String?                  @db.VarChar(255)
  score             Decimal?                 @db.Decimal(5, 2)
  feedback          String?                  @db.Text
  feedback_file_url String?                  @db.VarChar(255)
  status            exam_submissions_status? @default(pending)
  submission_date   DateTime?                @db.DateTime(0)
  created_at        DateTime?                @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                @default(now()) @db.Timestamp(0)
  exams             exams                    @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "exam_submissions_ibfk_1")

  @@unique([assignment_id, student_id], map: "unique_submission")
}

model exams {
  id               Int                @id @default(autoincrement())
  title            String             @db.VarChar(255)
  description      String?            @db.Text
  start_date       DateTime?          @db.DateTime(0)
  end_date         DateTime?          @db.DateTime(0)
  class_id         Int?
  program_id       Int
  subprogram_id    Int?
  due_date         DateTime?          @db.DateTime(0)
  total_points     Int?               @default(100)
  status           exams_status?      @default(active)
  created_by       Int
  duration         Int?
  questions        String?            @db.LongText
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  updated_at       DateTime?          @default(now()) @db.Timestamp(0)
  media_url        String?            @db.VarChar(255)
  exam_submissions exam_submissions[]
}

model freezing_requests {
  id             Int                       @id @default(autoincrement())
  student_id     String?                   @db.VarChar(50)
  reason         String                    @db.VarChar(100)
  start_date     DateTime                  @db.Date
  end_date       DateTime                  @db.Date
  description    String?                   @db.Text
  status         freezing_requests_status? @default(pending)
  admin_response String?                   @db.Text
  created_at     DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at     DateTime?                 @default(now()) @db.Timestamp(0)

  @@index([status], map: "idx_status")
  @@index([student_id], map: "idx_student_id")
}

model ielts_registrations {
  id                  Int       @id @default(autoincrement())
  full_name           String    @db.VarChar(255)
  email               String    @db.VarChar(255)
  phone               String?   @db.VarChar(50)
  age                 Int?
  gender              String?   @db.VarChar(50)
  location            String?   @db.VarChar(255)
  exam_type           String?   @db.VarChar(50)
  verification_method String?   @db.VarChar(50)
  certificate_details Json?
  exam_booking        Json?
  status              String?   @default("Pending") @db.VarChar(50)
  created_at          DateTime? @default(now()) @db.Timestamp(0)
}

model issued_certificates {
  id             Int                             @id @default(autoincrement())
  student_id     String                          @db.VarChar(50)
  student_name   String                          @db.VarChar(255)
  target_id      Int
  target_type    issued_certificates_target_type
  target_name    String                          @db.VarChar(255)
  class_name     String?                         @db.VarChar(255)
  certificate_id Int?
  issued_at      DateTime?                       @default(now()) @db.Timestamp(0)
  certificates   certificates?                   @relation(fields: [certificate_id], references: [id], onUpdate: NoAction, map: "issued_certificates_ibfk_1")

  @@index([certificate_id], map: "certificate_id")
  @@index([student_id], map: "idx_student_id")
  @@index([target_id, target_type], map: "idx_target")
}

model learning_materials {
  id              Int                        @id @default(autoincrement())
  title           String                     @db.VarChar(255)
  type            learning_materials_type
  program_id      Int?
  subprogram_id   Int?
  level           String?                    @default("All") @db.VarChar(50)
  subject         String?                    @db.VarChar(100)
  description     String?                    @db.Text
  url             String                     @db.Text
  status          learning_materials_status? @default(Active)
  created_at      DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at      DateTime?                  @default(now()) @db.Timestamp(0)
  created_by      Int?
  updated_by      Int?
  created_by_name String?                    @db.VarChar(200)
  updated_by_name String?                    @db.VarChar(200)
  programs        programs?                  @relation(fields: [program_id], references: [id], onUpdate: NoAction, map: "fk_material_program")
  subprograms     subprograms?               @relation(fields: [subprogram_id], references: [id], onUpdate: NoAction, map: "fk_material_subprogram")

  @@index([program_id], map: "fk_material_program")
  @@index([subprogram_id], map: "fk_material_subprogram")
}

model level_up_requests {
  id                      Int                       @id @default(autoincrement())
  student_id              String                    @db.VarChar(100)
  requested_subprogram_id Int
  status                  level_up_requests_status? @default(pending)
  admin_response          String?                   @db.Text
  description             String?                   @db.Text
  created_at              DateTime?                 @default(now()) @db.Timestamp(0)
  students                students                  @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "level_up_requests_ibfk_1")
  subprograms             subprograms               @relation(fields: [requested_subprogram_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "level_up_requests_ibfk_2")

  @@index([student_id], map: "level_up_requests_ibfk_1")
  @@index([requested_subprogram_id], map: "requested_subprogram_id")
}

model tutorials {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  media_type  String    @default("video") @db.VarChar(20)
  media_url   String    @db.VarChar(500)
  status      String?   @default("active") @db.VarChar(20)
  created_by  Int?
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamp(0)
}

model student_support_requests {
  id          Int       @id @default(autoincrement())
  student_id  String    @db.VarChar(50)
  category    String    @db.VarChar(50)
  subject     String    @db.VarChar(255)
  message     String    @db.Text
  status      String    @default("open") @db.VarChar(20)
  admin_reply String?   @db.Text
  replied_by  Int?
  replied_at  DateTime? @db.DateTime(0)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp(0)

  @@index([student_id])
  @@index([status])
}
model policies {
