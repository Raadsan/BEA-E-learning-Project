  programs             programs    @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timetables_ibfk_1")
  subprograms          subprograms @relation(fields: [subprogram_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timetables_ibfk_2")
  teachers             teachers?   @relation(fields: [teacher_id], references: [id], onUpdate: NoAction, map: "timetables_ibfk_3")

  @@index([program_id], map: "program_id")
  @@index([subprogram_id], map: "subprogram_id")
  @@index([teacher_id], map: "teacher_id")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model users {
  id    Int
  name  String @db.VarChar(200)
  email String @db.VarChar(200)

  @@ignore
}

model writing_task_submissions {
  id                Int                              @id @default(autoincrement())
  assignment_id     Int
  student_id        String?                          @db.VarChar(50)
  content           String?                          @db.LongText
  file_url          String?                          @db.VarChar(255)
  score             Decimal?                         @db.Decimal(5, 2)
  feedback          String?                          @db.Text
  feedback_file_url String?                          @db.VarChar(255)
  status            writing_task_submissions_status? @default(pending)
  submission_date   DateTime?                        @db.DateTime(0)
  created_at        DateTime?                        @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                        @default(now()) @db.Timestamp(0)
  writing_tasks     writing_tasks                    @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "writing_task_submissions_ibfk_1")

  @@unique([assignment_id, student_id], map: "unique_submission")
}

model writing_tasks {
  id                       Int                        @id @default(autoincrement())
  title                    String                     @db.VarChar(255)
  description              String?                    @db.Text
  class_id                 Int
  program_id               Int
  due_date                 DateTime?                  @db.DateTime(0)
  total_points             Int?                       @default(100)
  questions                String?                    @db.LongText
  status                   writing_tasks_status?      @default(active)
  created_by               Int
  word_count               Int?
  requirements             String?                    @db.Text
  created_at               DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                  @default(now()) @db.Timestamp(0)
  writing_task_submissions writing_task_submissions[]
}

