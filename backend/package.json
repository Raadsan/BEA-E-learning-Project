{
  "name": "backend",
  "version": "1.0.0",
  "description": "BEA E-Learning Backend with Prisma",
  "main": "server.js",
   "scripts": {
    "start": "cross-env PORT=7004 node server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "cross-env PORT=7004 nodemon server.js --ignore \"../frontend/\"",
    "client": "npm run dev --prefix ../frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run server\" \"npm run client\"",
    "prod": "concurrently -n backend,frontend -c blue,green \"cross-env PORT=7004 node server.js\" \"npm run start --prefix ../frontend\""
  },
  
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "deep-email-validator": "^0.1.27",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.5.2",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "nodemailer": "^7.0.11",
    "pdf-lib": "^1.17.1",
    "react-hot-toast": "^2.6.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.11",
    "prisma": "^7.8.0"
  }
}
